# Copy to .env in this repository's root. Keep DATABASE_URL on the server.
DATABASE_URL=
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Development-only Vite proxy target.
API_PROXY_TARGET=http://127.0.0.1:3001
# Public frontend value; leave empty to use the /api proxy.
VITE_API_URL=
REDIS_URL=redis://127.0.0.1:6387
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Server-only actor configuration; the default model is pinned in contracts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
