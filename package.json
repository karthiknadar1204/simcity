{
  "name": "simcity",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:check": "bun run --cwd packages/db db:check",
    "redis:start": "bun run scripts/redis-start.ts",
    "test:integration": "RUN_INTEGRATION=1 bun test packages/storage/src packages/jobs/src packages/agent-runtime/src packages/db/src",
    "verify:restart": "bun run --cwd apps/api build && bun run scripts/verify-restart.ts",
    "verify:autonomy": "RUN_MODEL_TESTS=1 bun run scripts/verify-autonomy.ts",
    "verify:thinking-restart": "bun run scripts/verify-thinking-restart.ts",
    "verify:memory": "RUN_MODEL_TESTS=1 bun run scripts/verify-memory.ts",
    "verify:memory-restart": "bun run scripts/verify-memory-restart.ts",
    "verify:town": "RUN_MODEL_TESTS=1 bun run scripts/verify-town.ts",
    "verify:town-restart": "bun run scripts/verify-town-restart.ts",
    "verify:video": "bun run scripts/verify-video.ts",
    "media:install": "bun run --cwd packages/media install-browser"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@neondatabase/serverless": "1.1.0"
  }
}
