{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema.ts",
    "./tables": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:check": "bun run src/check.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test src"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
